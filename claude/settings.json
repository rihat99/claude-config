{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(tree *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(which *)",
      "Bash(whoami)",
      "Bash(hostname *)",
      "Bash(uname *)",
      "Bash(nproc)",
      "Bash(free *)",
      "Bash(ps *)",
      "Bash(nvidia-smi *)",
      "Bash(md5sum *)",
      "Bash(md5 *)",
      "Bash(shasum *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(ln *)",
      "Bash(rsync *)",
      "Bash(chmod +x *)",
      "Bash(chmod u+x *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(gzip *)",
      "Bash(gunzip *)",
      "Bash(xz *)",
      "Bash(trash *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(find *)",
      "Bash(uv *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(npm *)",
      "Bash(tectonic *)",
      "Bash(latexmk *)",
      "Bash(pdflatex *)",
      "Bash(bibtex *)",
      "Bash(biber *)",
      "Bash(resvg *)",
      "Bash(rsvg-convert *)",
      "Bash(drawio *)",
      "Bash(soffice *)",
      "Bash(libreoffice *)",
      "Bash(git *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:*.readthedocs.io)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:pytorch.org)",
      "WebFetch(domain:stackoverflow.com)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(tmux *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "env": {},
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "autoUpdatesChannel": "stable",
  "cleanupPeriodDays": 90,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/skills/self-compact/hooks/deliver.py",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/skills/autoresearch/hooks/context_watch.py",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/skills/autoresearch/hooks/context_watch.py",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/skills/autoresearch/hooks/post_compact_state.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
